# Cấu hình môi trường cho EcoSchedule Backend
# Copy thành '.env' và điền thông tin Firebase CHUNG của nhóm (từ leader).

# Firebase Project ID (Firestore chung)
FIREBASE_PROJECT_ID=swp391-database

# Khóa API Web của Firebase (đăng nhập REST API)
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE

# Cổng backend — phải khớp VITE_API_URL ở frontend (mặc định 5001)
PORT=5001

# Tuỳ chọn: thay cho serviceAccountKey.json
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# SERVICE_ACCOUNT_PATH=

# URL frontend (dùng cho CORS allowlist, tuỳ chọn nếu deploy lên Render)
# FRONTEND_URL=https://swp391-database.web.app

# SMTP để gửi email xác nhận đăng ký / thông báo thanh toán
# Với Gmail: bật 2FA rồi tạo "App Password" tại https://myaccount.google.com/apppasswords
# (KHÔNG dùng mật khẩu Gmail thường — Google sẽ chặn đăng nhập)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM_NAME=EcoSchedule

# Cấu hình môi trường cho EcoSchedule Backend
# Hãy tạo bản sao của file này thành '.env' và điền thông tin cấu hình thật của bạn.

# Khóa API Web của Firebase (Dùng để xác thực qua REST API)
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE

# PayOS configuration
PAYOS_API_BASE_URL=https://sandbox.payos.example.com
PAYOS_CLIENT_ID=YOUR_PAYOS_CLIENT_ID
PAYOS_API_KEY=YOUR_PAYOS_API_KEY
PAYOS_CHECKSUM_KEY=YOUR_PAYOS_CHECKSUM_KEY

# Cổng khởi chạy Server Express
PORT=5000
